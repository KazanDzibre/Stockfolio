# ---- Docker Compose: container credentials ----
POSTGRES_USER=stockfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stockfolio
POSTGRES_PORT=5432

MONGO_USER=stockfolio
MONGO_PASSWORD=change-me
MONGO_PORT=27017

REDIS_PASSWORD=change-me
REDIS_PORT=6379

# ---- App connection strings (used by services from Phase 1 on) ----
# Written out in full on purpose: Node's env loaders don't expand ${VARS} inside .env.
DATABASE_URL=postgresql://stockfolio:change-me@localhost:5432/stockfolio
MONGO_URL=mongodb://stockfolio:change-me@localhost:27017/stockfolio?authSource=admin
REDIS_URL=redis://:change-me@localhost:6379
